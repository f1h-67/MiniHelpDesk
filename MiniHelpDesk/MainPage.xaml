<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiniHelpDesk.Views.MainPage"
             Title="Mini HelpDesk">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Dodaj nowe zgłoszenie" FontSize="18" FontAttributes="Bold" />

            <Entry Placeholder="Nazwa (min. 3 znaki)" Text="{Binding Name}" />
            <Editor Placeholder="Opis (min. 10 znaków)" Text="{Binding Description}" HeightRequest="80" />

            <Label Text="Priorytet:" />
            <Picker SelectedItem="{Binding SelectedPriority}">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Niski</x:String>
                        <x:String>Średni</x:String>
                        <x:String>Wysoki</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Button Text="Dodaj zgłoszenie" Command="{Binding AddCommand}" BackgroundColor="Navy" TextColor="White" />

            <Label Text="{Binding ValidationMessage}" TextColor="Red" FontAttributes="Bold" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,8" />

            <Label Text="Lista zgłoszeń" FontSize="18" FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding Tickets}" HeightRequest="300">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,4" Padding="10" BorderColor="Gray">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Description}" />
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding Priority, StringFormat='Priorytet: {0}'}" FontSize="12" TextColor="DarkSlateGray" />
                                    <Label Text="{Binding Status, StringFormat='Status: {0}'}" FontSize="12" TextColor="DarkBlue" />
                                </HorizontalStackLayout>
                                <Button Text="Usuń" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}" 
                                        CommandParameter="{Binding}" 
                                        BackgroundColor="Crimson" 
                                        TextColor="White" 
                                        HeightRequest="35" 
                                        FontSize="12" 
                                        Margin="0,6,0,0" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Uruchom Testy MSTest" Clicked="OnRunTestsClicked" BackgroundColor="DarkGreen" TextColor="White" Margin="0,10,0,0"/>
            <Label x:Name="TestResultsLabel" Text="" FontSize="12" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>